# Copia este archivo como `subir_testflight.env` (ignorado por git) y completa los valores.
# Los entrega el dueño de la cuenta desde App Store Connect → Users and Access → Integrations.
ID_LLAVE="XXXXXXXXXX"
ID_EMISOR="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Opcional: por defecto se busca en ~/.appstoreconnect/private_keys/AuthKey_<ID_LLAVE>.p8
# RUTA_LLAVE="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
